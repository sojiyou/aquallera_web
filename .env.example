# Copy this file to `.env` and fill in real values.
# REACT_APP_* variables are inlined at build time by create-react-app.
#
# Node-only env (not REACT_APP_*), used by `npm run migrate-passwords`
# (scripts/migratePasswords.js) — set these in your shell, they are NOT
# read from .env by the script:
#   FIREBASE_SERVICE_ACCOUNT=path/to/serviceAccountKey.json
#   FIREBASE_DATABASE_URL=https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase — https://console.firebase.google.com
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
# Storage not used until Firebase plan upgrade
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# EmailJS — main account (rejection + admin invite emails)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID_REJECTION=
REACT_APP_EMAILJS_TEMPLATE_ID_ADMIN_INVITE=
REACT_APP_EMAILJS_PUBLIC_KEY=

# EmailJS — approval account (approval emails)
REACT_APP_EMAILJS_APPROVAL_SERVICE_ID=
REACT_APP_EMAILJS_APPROVAL_TEMPLATE_ID=
REACT_APP_EMAILJS_APPROVAL_PUBLIC_KEY=

# Mapbox — https://account.mapbox.com/access-tokens
REACT_APP_MAPBOX_ACCESS_TOKEN=